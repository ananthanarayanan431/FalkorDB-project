# Knowledge-transfer API settings. Copy to .env (never commit .env).
# Defaults shown; every variable is optional in development.
# Source of truth: knowledge_transfer/core/config.py

# ---- deployment --------------------------------------------------------------
# development | production. Production turns off /docs and the voice demo page and
# expects ALLOWED_HOSTS and ALLOWED_ORIGINS to be set.
APP_ENV=development
LOG_LEVEL=INFO
# Interactive API docs at /docs and /openapi.json. Default: on in development, off in production.
# ENABLE_DOCS=
# Host headers the API answers to, comma separated. Empty accepts any (development only).
# ALLOWED_HOSTS=kt.example.com
# Browser origins allowed to open the voice WebSocket, comma separated.
# Default in development: http://localhost:3001, http://127.0.0.1:3001 and the same on port 8000.
# ALLOWED_ORIGINS=https://kt.example.com
# Largest request body, in bytes (default 5 MiB). Also limit it at your reverse proxy.
MAX_REQUEST_BYTES=5242880
# POST /api/v1/reset deletes everything. The API has no authentication: leave this off
# anywhere other people can reach.
ENABLE_RESET=false

# ---- stores ------------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_KT_GRAPH=knowledge_transfer
DATABASE_URL=postgresql+asyncpg://kt:kt@localhost:5432/knowledge_transfer

# ---- language model and voice (OpenRouter) ------------------------------------
# Optional. Without it questions and plan summaries use templates, and brain-dump
# import and voice interviews are unavailable.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Seconds before one LLM request is abandoned (the client retries a failed request twice).
LLM_TIMEOUT_S=60
STT_MODEL=deepgram/nova-3
TTS_MODEL=deepgram/aura-2
TTS_VOICE=aura-2-thalia-en
# Seconds of silence before a spoken answer is saved.
VOICE_GRACE_S=0.8
